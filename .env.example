# Optional Deadlock API key, used only by the Node server. Never use a VITE_ prefix.
# Copy to .env locally; leave empty to use public quotas.
DEADLOCK_API_KEY=

# Required only for Steam sign-in on a deployed site; localhost works without configuration.
# HTTPS origin only, e.g. https://atelier.example.com (no path, query or trailing slash).
APP_ORIGIN=
